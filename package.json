{
  "name": "invoices-api",
  "version": "1.0.0",
  "description": "API para guardar y gestionar facturas",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && cp src/infrastructure/persistence/postgres/schema.sql dist/infrastructure/persistence/postgres/schema.sql",
    "start": "node dist/server.js",
    "test": "vitest",
    "test:run": "vitest run",
    "db:migrate": "tsx src/infrastructure/persistence/postgres/migrate.ts",
    "test:matrix": "tsx scripts/test-matrix.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.14.0",
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "pg": "^8.22.0"
  }
}
